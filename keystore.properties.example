# Example only. Place the real properties file OUTSIDE this repository, then set
# YOURIPTV_UPLOAD_SIGNING_PROPERTIES to its absolute path. Never commit private values.
#
# storeFile resolves relative to that external properties file; an absolute path also works.
# Keep the keystore outside the repository.
storeFile=your-existing-upload-key.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
